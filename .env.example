# ── Application ─────────────────────────────────────────────
# Name shown in the API docs and responses
APP_NAME=Habita
# development | production
APP_ENV=development
# Prefix for every endpoint
API_PREFIX=/api/v1
# Port used by uvicorn inside Docker (Render sets it automatically)
PORT=8000

# ── Database ────────────────────────────────────────────────
# Local: SQLite file. Production: the PostgreSQL URL from Neon (postgresql://...)
DATABASE_URL=sqlite:///./habita.db
# true prints every SQL statement (debug only)
DATABASE_ECHO=false
# Only for docker compose: credentials of the local PostgreSQL container and the port exposed for the API
POSTGRES_DB=habita
POSTGRES_USER=habita
POSTGRES_PASSWORD=habita
API_PORT=8000

# ── Security ────────────────────────────────────────────────
# Frontend origins allowed to call the API, separated by commas
CORS_ORIGINS=http://localhost:5173
# Long random string (at least 32 characters) used to sign the JWT
JWT_SECRET=change-me-with-a-long-random-string-of-64-chars
JWT_ALGORITHM=HS256
# Session lifetime in minutes
JWT_EXPIRE_MINUTES=120
# Maximum attempts per IP (format: number/second|minute|hour)
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/minute

# ── Demo data (seed) ────────────────────────────────────────
# true runs the seed when the server starts (catalog + demo accounts, idempotent)
SEED_ON_STARTUP=true
# true adds sample projects to the demo user so the dashboard has data
SEED_DEMO_PROJECTS=true
# Password shared by both demo accounts
DEMO_PASSWORD=Habita2026
DEMO_USER_EMAIL=usuario@habita.app
DEMO_USER_NAME=Laura Gómez
DEMO_ADMIN_EMAIL=admin@habita.app
DEMO_ADMIN_NAME=Administrador Habita

# ── Money ───────────────────────────────────────────────────
# ISO currency used for prices and AI suggestions
CURRENCY_CODE=COP
# Budgets up to this amount use the economic strategy, up to the next one the standard strategy, above it premium
BUDGET_ECONOMIC_MAX=3000000
BUDGET_STANDARD_MAX=12000000

# ── 3D editor ───────────────────────────────────────────────
# Size in meters of the room created for a new 3D project
ROOM_DEFAULT_WIDTH=5
ROOM_DEFAULT_LENGTH=4
ROOM_DEFAULT_HEIGHT=2.7
# Maximum pieces of furniture a scene can hold
SCENE_MAX_NODES=150
# Saved versions kept per project (the oldest ones are removed)
SCENE_VERSIONS_LIMIT=20

# ── Assistant ───────────────────────────────────────────────
# Name the assistant uses to introduce itself
ASSISTANT_NAME=Lumi
# Maximum messages per IP sent to the assistant
ASSISTANT_RATE_LIMIT=20/minute
# Messages returned when the chat is opened
ASSISTANT_HISTORY_LIMIT=40
# Previous messages sent to the AI so it remembers the conversation
ASSISTANT_CONTEXT_MESSAGES=6

# ── Admin panel ─────────────────────────────────────────────
# Users per page in the admin user list
ADMIN_PAGE_SIZE=20
# Days shown in the admin activity chart
ADMIN_STATS_DAYS=14
# Show the demo accounts (and their password) in the in-app Documentation section
SHOW_DEMO_ACCOUNTS=true

# ── Image storage ───────────────────────────────────────────
# local = files in MEDIA_DIR (development) | database = files stored in PostgreSQL (production on Render)
STORAGE_PROVIDER=local
MEDIA_DIR=media
MEDIA_URL_PATH=/media
# Upload rules checked by the validation chain
MAX_UPLOAD_MB=8
MIN_IMAGE_SIDE=256
# Photos are resized to this longest side before sending them to the AI
MAX_IMAGE_SIDE=1536

# ── Artificial intelligence ─────────────────────────────────
# Provider for suggestions and Lumi: gemini | mock
AI_TEXT_PROVIDER=mock
# Provider for the redesigned image: cloudflare (free daily quota) | gemini (paid plan) | huggingface (paid credits) | mock
AI_IMAGE_PROVIDER=mock
# Used when the image provider fails (no credits, timeout): mock | none
AI_IMAGE_FALLBACK=mock
AI_TIMEOUT_SECONDS=90
# Number of AI answers kept in memory to avoid repeating the same request
AI_CACHE_SIZE=32
# Maximum redesigns per IP
REDESIGN_RATE_LIMIT=6/minute

# Google Gemini (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Cloudflare Workers AI (Account ID and an API token with "Workers AI" permission from https://dash.cloudflare.com)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_IMAGE_MODEL=@cf/runwayml/stable-diffusion-v1-5-img2img
# 0 keeps the photo as is, 1 ignores it; around 0.6 keeps the room and changes the decoration
CLOUDFLARE_IMAGE_STRENGTH=0.6
# Longest side sent to the model, in pixels
CLOUDFLARE_IMAGE_SIDE=768

# Hugging Face (token from https://huggingface.co/settings/tokens)
HUGGINGFACE_API_TOKEN=
# Inference provider that runs the model: auto | fal-ai | replicate | together | wavespeed | hf-inference
HUGGINGFACE_PROVIDER=auto
# Any image-to-image model offered by Hugging Face Inference Providers
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-Kontext-dev
